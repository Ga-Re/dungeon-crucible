{
  "name": "dungeon-crucible",
  "private": true,
  "version": "0.1.0",
  "description": "Campaign tool for D&D 5e: plan, build maps, run sessions with a table display",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "start": "node scripts/electron-dev.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/check-table-bundle.mjs && node scripts/build-electron.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "test": "vitest run",
    "lint:types": "tsc -b --noEmit",
    "bench": "VITE_BENCH=1 node scripts/electron-dev.mjs",
    "bench:video": "bash bench/make-video.sh"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "pixi.js": "^8.22.0",
    "polyclip-ts": "^0.16.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  }
}
